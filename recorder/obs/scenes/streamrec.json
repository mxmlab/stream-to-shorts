            "settings": {
                "url": "https://www.twitch.tv/popout/YOUR_CHANNEL/chat?popout=",
                "width": 400,
                "height": 600,
                "css": "/* Делаем весь фон прозрачным */\nhtml, body, #root, .tw-root--theme-dark, .tw-root--theme-light {\n    background: transparent !important;\n    background-color: transparent !important;\n    overflow: hidden !important;\n}\n\n/* Прячем верхнюю панель (Stream Chat / заголовок) */\n.stream-chat-header, \ndiv[data-test-selector=\"chat-header\"] {\n    display: none !important;\n}\n\n/* Прячем поле ввода сообщения, плашки подсказок и кнопки снизу */\n.chat-input, \n.chat-input__textarea,\ndiv[data-test-selector=\"chat-input\"],\n.community-points-summary,\n.channel-points-reward-button,\ndiv[class*=\"announcement-banner\"],\ndiv[class*=\"animated-emotes\"] {\n    display: none !important;\n}\n\n/* Убираем фон под контейнером сообщений */\n.chat-room, \n.chat-scrollable-area__message-container,\n.simplebar-scroll-content,\n.simplebar-content {\n    background: transparent !important;\n    background-color: transparent !important;\n}\n\n/* Добавляем читаемую тень тексту, чтобы чат читался на любом фоне видео */\n.chat-line__message {\n    text-shadow: 1px 1px 2px #000, -1px -1px 2px #000, 1px -1px 2px #000, -1px 1px 2px #000 !important;\n}"
            },
