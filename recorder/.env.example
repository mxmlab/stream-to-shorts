# streamrec configuration.
# Copy to ~/streamrec/.env (install.sh does this) and fill in the values.
# The environment takes precedence over this file.

# Twitch channel login to record. The only place the channel is configured:
# no channel is hard-coded in the script or in the OBS scene.
# Example: STREAMREC_CHANNEL=your_twitch_login
STREAMREC_CHANNEL=

# obs-websocket password (OBS: Tools -> WebSocket Server Settings).
# Copy it from there. Without it OBS rejects the connection when auth is on.
OBS_WS_PASSWORD=

# Where the recordings go. Must match RecFilePath in the OBS profile
# (install.sh fills that in from this value). Default: ~/Videos/streams
STREAMREC_OUTDIR=

# Alias for OBS_WS_PASSWORD, understood for backwards compatibility:
# OBS_WEBSOCKET_PASSWORD=

# Optional obs-websocket endpoint overrides (defaults: 127.0.0.1 / 4455).
# OBS_WS_HOST=
# OBS_WS_PORT=
